# Xiaozhi ESP32 Endpoints Configuration
# Copy this file to .env and fill in your endpoint values
# Use scripts/load_env_to_settings.py to load these values into device settings

# OTA (Over-The-Air) Update Endpoint
OTA_URL=http://212.67.8.211:8080/ota/

# WebSocket Server Configuration
WEBSOCKET_URL=
WEBSOCKET_TOKEN=
WEBSOCKET_VERSION=3

# MQTT Server Configuration
MQTT_ENDPOINT=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PUBLISH_TOPIC=
MQTT_KEEPALIVE=240

# Audio Debug UDP Server (for development/debugging)
AUDIO_DEBUG_UDP_SERVER=192.168.2.100:8000





